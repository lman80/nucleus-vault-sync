{
  "name": "obsidian-nucleus-plugin",
  "version": "0.14.0",
  "description": "Sync an Obsidian vault with your own Nucleus data layer, on desktop and mobile.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "tsx --test src/core/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "private": true,
  "type": "module"
}
